@echo off
setlocal

:: Get the path of the dragged file
set "batfile=%~1"

:: Check if the file exists and is a .bat file
if not exist "%batfile%" (
    echo Error: File not found!
    pause
    exit /b
)
if /i not "%~x1"==".bat" (
    echo Error: Not a .bat file!
    pause
    exit /b
)

:: Set output exe file name (same as batch name)
set "exefile=%~dpn1.exe"

:: Use IExpress to create the exe
echo Creating EXE from "%batfile%"...

:: Create a temporary sed directive for IExpress
set "sedfile=%temp%\iexpress.sed"
(
    echo [Version]
    echo Class=IEXPRESS
    echo [Options]
    echo PackagePurpose=InstallApp
    echo ShowInstallProgramWindow=0
    echo HideExtractAnimation=1
    echo UseLongFileNames=1
    echo InsideCompressed=0
    echo CAB_FixedSize=0
    echo CAB_ResvCodeSigning=0
    echo RebootMode=N
    echo InstallPrompt=
    echo DisplayLicense=
    echo FinishMessage=
    echo TargetName=%exefile%
    echo FriendlyName=Batch to EXE
    echo AppLaunched=cmd.exe /c "%batfile%"
    echo PostInstallCmd=<None>
    echo AdminQuietInstCmd=
    echo UserQuietInstCmd=
    echo SourceFiles=SourceFiles
    echo [SourceFiles]
    echo SourceFiles0=
    echo [SourceFiles0]
    echo %batfile%
) > "%sedfile%"

:: Run IExpress
iexpress /n /q "%sedfile%"

:: Clean up
del "%sedfile%"

if exist "%exefile%" (
    echo Success! Created: "%exefile%"
) else (
    echo Failed to create EXE!
)

pause
